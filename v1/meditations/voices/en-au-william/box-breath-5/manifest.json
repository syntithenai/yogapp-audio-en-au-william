    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.085
    },
    {
      "index": 1,
      "text": "Find a comfortable seat, or lie down if that feels better.",
      "file": "c001.ogg",
      "durationSec": 5.437
    },
    {
      "index": 2,
      "text": "Let the hands rest.",
      "file": "c002.ogg",
      "durationSec": 2.136
    },
    {
      "index": 3,
      "text": "Soften the eyes, or close them.",
      "file": "c003.ogg",
      "durationSec": 3.934
    },
    {
      "index": 4,
      "text": "Take a slow breath in.",
      "file": "c004.ogg",
      "durationSec": 2.618
    },
    {
      "index": 5,
      "text": "And a longer breath out.",
      "file": "c005.ogg",
      "durationSec": 2.297
    },
    {
      "index": 6,
      "text": "We will breathe in a simple box.",
      "file": "c006.ogg",
      "durationSec": 3.231
    },
    {
      "index": 7,
      "text": "In for four. Hold for four. Out for four. Hold for four.",
      "file": "c007.ogg",
      "durationSec": 6.895
    },
    {
      "index": 8,
      "text": "Stay gentle. Never strain.",
      "file": "c008.ogg",
      "durationSec": 3.293
    },
    {
      "index": 9,
      "text": "[pause:20]",
      "file": "c009.ogg",
      "durationSec": 20.0,
      "silence": true
    },
    {
      "index": 10,
      "text": "Inhale. Two. Three. Four.",
      "file": "c010.ogg",
      "durationSec": 4.273
    },
    {
      "index": 11,
      "text": "Hold. Two. Three. Four.",
      "file": "c011.ogg",
      "durationSec": 3.408
    },
    {
      "index": 12,
      "text": "Exhale. Two. Three. Four.",
      "file": "c012.ogg",
      "durationSec": 3.754
    },
    {
      "index": 13,
      "text": "Hold. Two. Three. Four.",
      "file": "c013.ogg",
      "durationSec": 3.822
    },
    {
      "index": 14,
      "text": "[pause:20]",
      "file": "c014.ogg",
      "durationSec": 20.0,
      "silence": true
    },
    {
      "index": 15,
      "text": "Again. Inhale.",
      "file": "c015.ogg",
      "durationSec": 2.771
    },
    {
      "index": 16,
      "text": "Hold.",
      "file": "c016.ogg",
      "durationSec": 1.321
    },
    {
      "index": 17,
      "text": "Exhale.",
      "file": "c017.ogg",
      "durationSec": 1.498
    },
    {
      "index": 18,
