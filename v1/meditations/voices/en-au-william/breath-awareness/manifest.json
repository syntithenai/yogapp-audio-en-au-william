{
  "id": "breath-awareness",
  "voiceId": "en-au-william",
  "edgeVoice": "en-AU-WilliamMultilingualNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 83,
  "chunks": [
    {
      "index": 0,
      "text": "Settle into a steady posture.",
      "file": "c000.ogg",
      "durationSec": 3.124
    },
    {
      "index": 1,
      "text": "Spine tall but not rigid.",
      "file": "c001.ogg",
      "durationSec": 3.529
    },
    {
      "index": 2,
      "text": "Bring attention to the breath as it already is.",
      "file": "c002.ogg",
      "durationSec": 4.683
    },
    {
      "index": 3,
      "text": "Do not change it yet. Just watch.",
      "file": "c003.ogg",
      "durationSec": 3.637
    },
    {
      "index": 4,
      "text": "Feel the coolness of the inhale at the nostrils.",
      "file": "c004.ogg",
      "durationSec": 4.515
    },
    {
      "index": 5,
      "text": "Feel the warmth of the exhale.",
      "file": "c005.ogg",
      "durationSec": 3.121
    },
    {
      "index": 6,
      "text": "Or notice the rise and fall of the belly.",
      "file": "c006.ogg",
      "durationSec": 3.935
    },
    {
      "index": 7,
      "text": "Choose one place to rest your attention.",
      "file": "c007.ogg",
      "durationSec": 3.705
    },
    {
      "index": 8,
      "text": "When the mind wanders, kindly return.",
      "file": "c008.ogg",
      "durationSec": 4.22
    },
    {
      "index": 9,
      "text": "No judgment. Just return.",
      "file": "c009.ogg",
      "durationSec": 3.056
    },
    {
      "index": 10,
      "text": "Now, if it feels easy, count soft cycles.",
      "file": "c010.ogg",
      "durationSec": 4.632
    },
    {
      "index": 11,
      "text": "Inhale. One.",
      "file": "c011.ogg",
      "durationSec": 2.894
    },
    {
      "index": 12,
      "text": "Exhale. One.",
      "file": "c012.ogg",
      "durationSec": 2.656
    },
    {
      "index": 13,
      "text": "Inhale. Two.",
      "file": "c013.ogg",
      "durationSec": 2.551
    },
    {
      "index": 14,
      "text": "Exhale. Two.",
      "file": "c014.ogg",
      "durationSec": 2.544
    },
    {
      "index": 15,
      "text": "Continue up to five, then begin again at one.",
      "file": "c015.ogg",
      "durationSec": 4.867
    },
    {
      "index": 16,
      "text": "If you lose the count, start over with kindness.",
      "file": "c016.ogg",
      "durationSec": 5.211
    },
    {
      "index": 17,
      "text": "The returning is the practice.",
      "file": "c017.ogg",
      "durationSec": 3.078
    },
    {
      "index": 18,
      "text": "Let the breath be natural. No strain.",
      "file": "c018.ogg",
      "durationSec": 4.573
    },
    {
      "index": 19,
      "text": "A few more cycles in silence.",
      "file": "c019.ogg",
      "durationSec": 3.242
    },
    {
      "index": 20,
      "text": "Release the counting.",
      "file": "c020.ogg",
      "durationSec": 2.24
    },
    {
      "index": 21,
      "text": "Rest in open awareness for a moment.",
      "file": "c021.ogg",
      "durationSec": 3.581
    },
    {
      "index": 22,
      "text": "When ready, open your eyes.",
      "file": "c022.ogg",
      "durationSec": 3.12
    }
  ],
