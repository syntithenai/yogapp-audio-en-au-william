    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.037
    },
    {
      "index": 1,
      "text": "Take time to arrive.",
      "file": "c001.ogg",
      "durationSec": 2.6
    },
    {
      "index": 2,
      "text": "Sit or lie down with support.",
      "file": "c002.ogg",
      "durationSec": 2.887
    },
    {
      "index": 3,
      "text": "Close the eyes if that feels safe.",
      "file": "c003.ogg",
      "durationSec": 3.519
    },
    {
      "index": 4,
      "text": "Feel contact with the ground.",
      "file": "c004.ogg",
      "durationSec": 2.714
    },
    {
      "index": 5,
      "text": "Slow breath in.",
      "file": "c005.ogg",
      "durationSec": 2.013
    },
    {
      "index": 6,
      "text": "Longer breath out.",
      "file": "c006.ogg",
      "durationSec": 2.024
    },
    {
      "index": 7,
      "text": "[pause:27]",
      "file": "c007.ogg",
      "durationSec": 27.0,
      "silence": true
    },
    {
      "index": 8,
      "text": "Again.",
      "file": "c008.ogg",
      "durationSec": 1.316
    },
    {
      "index": 9,
      "text": "[pause:27]",
      "file": "c009.ogg",
      "durationSec": 27.0,
      "silence": true
    },
    {
      "index": 10,
      "text": "Let the shoulders drop.",
      "file": "c010.ogg",
      "durationSec": 2.312
    },
    {
      "index": 11,
      "text": "Let the belly soften.",
      "file": "c011.ogg",
      "durationSec": 2.436
    },
    {
      "index": 12,
      "text": "[pause:34]",
      "file": "c012.ogg",
      "durationSec": 34.0,
      "silence": true
    },
    {
      "index": 13,
      "text": "We will offer kindness in a widening circle.",
      "file": "c013.ogg",
      "durationSec": 4.169
    },
    {
      "index": 14,
      "text": "Phrases are invitations, not commands.",
      "file": "c014.ogg",
      "durationSec": 4.464
    },
    {
      "index": 15,
      "text": "[pause:34]",
      "file": "c015.ogg",
      "durationSec": 34.0,
      "silence": true
    },
    {
      "index": 16,
      "text": "Toward yourself.",
      "file": "c016.ogg",
      "durationSec": 2.074
    },
    {
      "index": 17,
      "text": "May I be safe.",
