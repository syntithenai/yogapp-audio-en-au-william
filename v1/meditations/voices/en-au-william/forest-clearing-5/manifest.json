{
  "id": "forest-clearing-5",
  "voiceId": "en-au-william",
  "edgeVoice": "en-AU-WilliamMultilingualNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 238,
  "chunks": [
    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.335
    },
    {
      "index": 1,
      "text": "Take a comfortable seat, or lie down if that feels better.",
      "file": "c001.ogg",
      "durationSec": 5.558
    },
    {
      "index": 2,
      "text": "Let your hands rest.",
      "file": "c002.ogg",
      "durationSec": 2.422
    },
    {
      "index": 3,
      "text": "Allow your eyes to close, or soften your gaze.",
      "file": "c003.ogg",
      "durationSec": 5.036
    },
    {
      "index": 4,
      "text": "Notice the weight of your body being held.",
      "file": "c004.ogg",
      "durationSec": 3.873
    },
    {
      "index": 5,
      "text": "Take a slow breath in through the nose.",
      "file": "c005.ogg",
      "durationSec": 3.701
    },
    {
      "index": 6,
      "text": "And a longer, easier breath out.",
      "file": "c006.ogg",
      "durationSec": 3.7
    },
    {
      "index": 7,
      "text": "Again. Soft inhale.",
      "file": "c007.ogg",
      "durationSec": 3.173
    },
    {
      "index": 8,
      "text": "Gentle exhale.",
      "file": "c008.ogg",
      "durationSec": 1.957
    },
    {
      "index": 9,
      "text": "If thoughts wander, that is fine. Return to the breath.",
      "file": "c009.ogg",
      "durationSec": 5.896
    },
    {
      "index": 10,
      "text": "Now, imagine a path beneath soft leaf litter.",
      "file": "c010.ogg",
      "durationSec": 5.033
    },
    {
      "index": 11,
      "text": "You walk without hurry into a quiet forest.",
      "file": "c011.ogg",
      "durationSec": 4.399
    },
    {
      "index": 12,
      "text": "Dappled light moves across your forearms.",
      "file": "c012.ogg",
      "durationSec": 4.051
    },
    {
      "index": 13,
      "text": "Feel the gentle warmth of the sun wherever it finds skin.",
      "file": "c013.ogg",
      "durationSec": 5.725
    },
    {
      "index": 14,
      "text": "A cool freshness rides the breeze between the trees.",
      "file": "c014.ogg",
      "durationSec": 5.209
    },
    {
      "index": 15,
      "text": "Smell green earth, bark, and a clean mineral dampness.",
      "file": "c015.ogg",
      "durationSec": 6.49
    },
    {
      "index": 16,
      "text": "The path opens into a small clearing.",
      "file": "c016.ogg",
      "durationSec": 3.758
    },
    {
      "index": 17,
      "text": "Moss cushions a fallen log. You sit.",
      "file": "c017.ogg",
      "durationSec": 4.051
    },
    {
      "index": 18,
      "text": "Sunlight pools in the center like quiet gold.",
      "file": "c018.ogg",
      "durationSec": 4.567
    },
    {
      "index": 19,
      "text": "Feel that warmth on your face, slow and kind.",
      "file": "c019.ogg",
      "durationSec": 5.549
    },
    {
      "index": 20,
      "text": "A breeze touches your hair and cools your temples.",
      "file": "c020.ogg",
      "durationSec": 4.863
    },
    {
      "index": 21,
      "text": "Birdsong arrives from far away, then fades.",
      "file": "c021.ogg",
      "durationSec": 4.687
    },
    {
      "index": 22,
      "text": "Your breath matches the hush of the leaves.",
      "file": "c022.ogg",
      "durationSec": 3.822
    },
    {
      "index": 23,
      "text": "Inhale the freshness. Exhale any leftover haste.",
      "file": "c023.ogg",
      "durationSec": 6.143
    },
    {
      "index": 24,
      "text": "Notice how safe the ground feels under you.",
      "file": "c024.ogg",
      "durationSec": 3.94
    },
    {
      "index": 25,
      "text": "How wide the sky seems above the canopy.",
      "file": "c025.ogg",
      "durationSec": 4.288
    },
    {
      "index": 26,
      "text": "A beetle crosses a sunlit patch of bark, unhurried.",
      "file": "c026.ogg",
      "durationSec": 5.847
    },
    {
      "index": 27,
      "text": "You have nowhere to be but here.",
      "file": "c027.ogg",
      "durationSec": 3.291
    },
    {
      "index": 28,
      "text": "Warmth pools again on your closed eyelids.",
      "file": "c028.ogg",
      "durationSec": 3.99
    },
    {
      "index": 29,
      "text": "Cool air slips under your collar like a kind hand.",
      "file": "c029.ogg",
      "durationSec": 5.092
    },
    {
      "index": 30,
      "text": "Stay with the warmth on your cheeks.",
      "file": "c030.ogg",
      "durationSec": 3.288
    },
    {
      "index": 31,
      "text": "Stay with the cool air on your lips as you breathe out.",
      "file": "c031.ogg",
      "durationSec": 4.86
    },
    {
      "index": 32,
      "text": "This clearing asks nothing. It simply holds you.",
      "file": "c032.ogg",
      "durationSec": 5.316
    },
    {
      "index": 33,
      "text": "Let one more breath travel all the way to the belly.",
      "file": "c033.ogg",
      "durationSec": 5.494
    },
    {
      "index": 34,
      "text": "And leave again, soft as the leaves.",
      "file": "c034.ogg",
      "durationSec": 3.988
    },
    {
      "index": 35,
      "text": "Wander your attention slowly around the clearing’s edge.",
      "file": "c035.ogg",
      "durationSec": 5.09
    },
    {
      "index": 36,
      "text": "Fern. Shadow. A pale mushroom at the base of a stump.",
      "file": "c036.ogg",
      "durationSec": 7.186
    },
    {
      "index": 37,
      "text": "Everything is vivid because you are not rushing.",
      "file": "c037.ogg",
      "durationSec": 4.516
    },
    {
      "index": 38,
      "text": "Feel sun-warmth again where it lands on the knee.",
      "file": "c038.ogg",
      "durationSec": 4.337
    },
    {
      "index": 39,
      "text": "Feel breeze-coolness where it slips across the throat.",
      "file": "c039.ogg",
      "durationSec": 5.155
    },
    {
      "index": 40,
      "text": "You could stay here all afternoon. For now, a few breaths are enough.",
      "file": "c040.ogg",
      "durationSec": 7.765
    },
    {
      "index": 41,
      "text": "Now rest in the breath alone for a little while.",
      "file": "c041.ogg",
      "durationSec": 4.049
    },
    {
      "index": 42,
      "text": "Inhale slowly.",
      "file": "c042.ogg",
      "durationSec": 2.188
    },
    {
      "index": 43,
      "text": "Exhale slowly.",
      "file": "c043.ogg",
      "durationSec": 2.307
    },
    {
      "index": 44,
      "text": "Inhale.",
      "file": "c044.ogg",
      "durationSec": 1.436
    },
    {
      "index": 45,
      "text": "Exhale.",
      "file": "c045.ogg",
      "durationSec": 1.499
    },
    {
      "index": 46,
      "text": "Feel warmth wherever the body is warm.",
      "file": "c046.ogg",
      "durationSec": 3.71
    },
    {
      "index": 47,
      "text": "Feel coolness wherever the air is cool.",
      "file": "c047.ogg",
      "durationSec": 3.873
    },
    {
      "index": 48,
      "text": "Inhale.",
      "file": "c048.ogg",
      "durationSec": 1.442
    },
    {
      "index": 49,
      "text": "Exhale.",
      "file": "c049.ogg",
      "durationSec": 1.205
    },
    {
      "index": 50,
      "text": "Nowhere to go. Nothing to fix.",
      "file": "c050.ogg",
      "durationSec": 3.356
    },
    {
      "index": 51,
      "text": "Inhale.",
      "file": "c051.ogg",
      "durationSec": 1.439
    },
    {
      "index": 52,
      "text": "Exhale.",
      "file": "c052.ogg",
      "durationSec": 1.494
    },
    {
      "index": 53,
      "text": "Rest here for a few quiet breaths.",
      "file": "c053.ogg",
      "durationSec": 3.639
    },
    {
      "index": 54,
      "text": "Know that you can return to this place anytime.",
      "file": "c054.ogg",
      "durationSec": 5.207
    },
    {
      "index": 55,
      "text": "When you are ready, deepen the breath.",
      "file": "c055.ogg",
      "durationSec": 3.944
    },
    {
      "index": 56,
      "text": "Wiggle fingers and toes.",
      "file": "c056.ogg",
      "durationSec": 2.707
    },
    {
      "index": 57,
      "text": "Open your eyes softly.",
      "file": "c057.ogg",
      "durationSec": 2.538
    },
    {
      "index": 58,
      "text": "Carry a little of this peace with you.",
      "file": "c058.ogg",
      "durationSec": 3.293
    }
  ],
